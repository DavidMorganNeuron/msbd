# PROFIL DEV LOKAL. Jangan pakai kredensial ini di lingkungan lain.
# ===== APLIKASI =====
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
DEMO_ROLE_PASSWORD=test123

# ===== LOG, SESSION, CACHE, QUEUE, FILESYSTEM =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

# ===== DATABASE: PENGATURAN BERSAMA (PostgreSQL msbd_tubes_kel7) =====
DB_CONNECTION=pgsql
DB_SEARCH_PATH="public, pg_catalog, pg_temp"
DB_SSLMODE=prefer

# Akun DB role app_login (default runtime Laravel): pgsql
DB_HOST=127.0.0.1
DB_DATABASE=msbd_tubes_kel7
DB_USERNAME=app_login
DB_PASSWORD=1
DB_PORT=5432

# Akun DB role app_owner (pemilik objek/DDL, hanya untuk verifikasi & DBeaver): pgsql_owner
DB_HOST_OWNER=127.0.0.1
DB_DATABASE_OWNER=msbd_tubes_kel7
DB_USERNAME_OWNER=app_owner
DB_PASSWORD_OWNER=1
DB_PORT_OWNER=5432

# Akun DB role siswa: pgsql_siswa
DB_HOST_SISWA=127.0.0.1
DB_DATABASE_SISWA=msbd_tubes_kel7
DB_USERNAME_SISWA=role_siswa
DB_PASSWORD_SISWA=1
DB_PORT_SISWA=5432

# Akun DB role tu: pgsql_tu
DB_HOST_TU=127.0.0.1
DB_DATABASE_TU=msbd_tubes_kel7
DB_USERNAME_TU=role_tu
DB_PASSWORD_TU=1
DB_PORT_TU=5432

# Akun DB role kepsek: pgsql_kepsek
DB_HOST_KEPSEK=127.0.0.1
DB_DATABASE_KEPSEK=msbd_tubes_kel7
DB_USERNAME_KEPSEK=role_kepsek
DB_PASSWORD_KEPSEK=1
DB_PORT_KEPSEK=5432

# Akun DB role wali_kelas: pgsql_wali_kelas
DB_HOST_WALI_KELAS=127.0.0.1
DB_DATABASE_WALI_KELAS=msbd_tubes_kel7
DB_USERNAME_WALI_KELAS=role_wali_kelas
DB_PASSWORD_WALI_KELAS=1
DB_PORT_WALI_KELAS=5432

# ===== LAYANAN LAIN (belum dipakai proyek) =====
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== ARSIP (nonaktif) =====
# DB_CONNECTION=sqlite
